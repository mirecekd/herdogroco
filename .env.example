# Base URL of the Hermes Agent API server profile (OpenAI-compatible, /v1).
# The profile is served by Hermes under /p/<profile>/v1.
HERMES_URL=http://127.0.0.1:8642/p/grokovo/v1

# API_SERVER_KEY of the Hermes profile (from ~/.hermes/profiles/grokovo/.env).
# Required. Never commit the real value.
HERMES_KEY=

# Public HTTPS URL of this service (the Caddy site address). Used to build the
# OAuth metadata and the connector URL printed by `pair`.
PUBLIC_URL=https://herdogroco.dev.mirecek.org

# Port the app listens on.
PORT=8130

# Hermes session name that all Grok requests are grouped under.
HERMES_SESSION=herdogroco-grok

# Seconds to wait for a Hermes answer before the task continues in the
# background and Grok gets a task id to poll with hermes_task_status.
HERMES_SYNC_TIMEOUT=25

# Log verbosity. INFO = one line per request plus OAuth/MCP/Hermes events.
# DEBUG = adds safe request headers, discovery hits, Hermes call timing and
# the MCP response size. WARNING = rejections and problems only.
# Values: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Log format: text (human readable, key=value) or json (one object per line,
# for Loki / CloudWatch / jq).
LOG_FORMAT=text

# Write the task text Grok sends and the answers Hermes returns into the log.
# Off by default because voice requests are personal. Tokens, cookies, pairing
# codes and the Hermes key are NEVER logged, whatever this is set to.
LOG_CONTENT=false

# Longest content snippet written to the log (characters).
LOG_CONTENT_MAX=500

# Optional: text prepended to every task sent to Hermes. Leave unset to use
# the built-in voice-assistant prefix (short spoken answers, no markdown).
# TASK_PREFIX=
